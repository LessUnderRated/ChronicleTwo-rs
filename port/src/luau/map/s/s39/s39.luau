--- The event the engine runs on entering a town or interior, jumping to a map and leaving it, and the one an omitted event number means.
function script.default_event()
	local flag: s32 = 0
	local var1: s32 = 0
	local flag_2: s32 = 0
	local chara_id: s32 = 0
	local at: number = 0
	return vm.guard(function()
		var1 = 0
		flag = event.GetFlag(524) or flag
		if flag == 0 then
			var1 = 1
			event.AddItem(354, 1)
			at = 1
			helper_12aa0()
		end
		if helper_5a735084() ~= 0 then
			var1 = 1
			event.AddItem(82, 1)
			at = 2
			helper_17708()
		end
		if var1 == 1 then
			return
		end
		flag_2 = event.GetFlag(536) or flag_2
		if flag_2 ~= 0 then
			chara_id = event.GetCharaId(400) or chara_id
			event.CharaActive(0, chara_id)
		end
		event.SetCharaPos(0, 0.0, 30.0, -180.0)
		event.SetCharaRot(0, 0.0, 0.0, 0.0)
		event.ResetCamera(1, 0.0, 10.0)
		event.SetFadeIn(15)
		return
	end, function(received: { any })
		if at <= 2 then
			if at <= 1 then
				local _ = helper_fb78ba4a()
				var1 = 1
				at = 2
				helper_17708()
				return vm.continue_with(function()
					if var1 == 1 then
						return
					end
					flag_2 = event.GetFlag(536) or flag_2
					if flag_2 ~= 0 then
						chara_id = event.GetCharaId(400) or chara_id
						event.CharaActive(0, chara_id)
					end
					event.SetCharaPos(0, 0.0, 30.0, -180.0)
					event.SetCharaRot(0, 0.0, 0.0, 0.0)
					event.ResetCamera(1, 0.0, 10.0)
					event.SetFadeIn(15)
					return
				end)
			end
			return 0
		end
		return nil
	end)
end

