+// The renderer's pipeline-set identity, hashed from the embedded shader blobs and the
+// specialization/pipeline shape. A cache file from another renderer build must never be loaded:
+// the entries key on the shader modules, and a driver may hand back compiled code whose
+// specialization does not match the requesting pipeline's - on Adreno the skinned pipelines came
+// back running the unskinned variant's vertex shader, so every character drew its bind pose.
+constexpr uint8_t kCacheMagic[8] = {'K', 'Z', 'P', 'C', '1', 0, 0, 0};
+
+std::uint64_t CacheIdentity() {
+    std::uint64_t         hash = 14695981039346656037ull;
+    const auto  mix = [&hash](const void *bytes, size_t size) {
+        const auto *cursor = static_cast<const uint8_t *>(bytes);
+        for (size_t i = 0; i < size; i++) {
+            hash = (hash ^ cursor[i]) * 1099511628211ull;
+        }
+    };
+    mix(draw2d_vert, sizeof(draw2d_vert));
+    mix(mesh_vert, sizeof(mesh_vert));
+    mix(mesh_prog0_vert, sizeof(mesh_prog0_vert));
+    mix(mesh_prog0_bound_vert, sizeof(mesh_prog0_bound_vert));
+    mix(mesh_prog0_skinned_vert, sizeof(mesh_prog0_skinned_vert));
+    mix(mesh_prog0_bound_skinned_vert, sizeof(mesh_prog0_bound_skinned_vert));
+    mix(draw_frag, sizeof(draw_frag));
+    mix(draw_bound_frag, sizeof(draw_bound_frag));
+    mix(draw_single_frag, sizeof(draw_single_frag));
+    mix(draw_bound_single_frag, sizeof(draw_bound_single_frag));
+    // The descriptor mode changes which shader variant every prog0 family runs, so a cache from
+    // the other mode must not be reused either.
+    const uint8_t bindless = g.bindless ? 1 : 0;
+    mix(&bindless, sizeof(bindless));
+    const std::uint64_t shape = (static_cast<std::uint64_t>(kFamilyCount) << 48) |
+                                (static_cast<std::uint64_t>(kAlphaVariantCount) << 32) |
+                                (static_cast<std::uint64_t>(kFragmentFeatureCount) << 16) | sizeof(PushConstants);
+    mix(&shape, sizeof(shape));
+    return hash;
+}
+
+/** The 16-byte stamp a cache file opens with: the magic and the pipeline-set identity. */
+void WriteCacheStamp(uint8_t (&stamp)[16]) {
+    std::memcpy(stamp, kCacheMagic, sizeof(kCacheMagic));
+    const std::uint64_t identity = CacheIdentity();
+    std::memcpy(stamp + sizeof(kCacheMagic), &identity, sizeof(identity));
+}
+
+/** Reads a cache file's stamp and reports whether it belongs to this renderer build. */
+bool CacheStampMatches(std::ifstream &file) {
+    uint8_t stamp[16] = {};
+    if (!file.read(reinterpret_cast<char *>(stamp), sizeof(stamp)) ||
+        std::memcmp(stamp, kCacheMagic, sizeof(kCacheMagic)) != 0) {
+        return false;
+    }
+    std::uint64_t stored = 0;
+    std::memcpy(&stored, stamp + sizeof(kCacheMagic), sizeof(stored));
+    return stored == CacheIdentity();
+}
