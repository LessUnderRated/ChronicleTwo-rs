+// The skin-palette ring, used on the pushed-descriptor path only. The bone matrices travel through
+// the texture pipe there: Adreno's compiler misreads the vertex stage's dynamically indexed storage
+// buffer the bindless path delivers them through, and every skinned character drew its bind pose.
+// Each placement takes the next ring texture, uploads its 96 texels (32 bones, 3 rows each) and the
+// draw's pushed palette slot names it; the fragment stage never reads it for an RGBA draw.
+constexpr uint32_t kSkinPaletteRingSize = 64;
+constexpr uint32_t kSkinPaletteWidth = static_cast<uint32_t>(kProg0Bones) * 3;
+
+TextureHandle SkinPaletteRing[kSkinPaletteRingSize] = {};
+uint32_t      SkinPaletteCursor = 0;
+
+void CreateSkinPaletteRing() {
+    TextureDesc desc{};
+    desc.width = kSkinPaletteWidth;
+    desc.height = 1;
+    desc.format = TextureFormat::FloatRgba;
+    for (TextureHandle &slot : SkinPaletteRing) {
+        slot = CreateTexture(desc);
+    }
+}
+
+TextureHandle SkinPaletteTexture(const Prog0Palette &palette) {
+    const uint32_t slot = SkinPaletteCursor++ % kSkinPaletteRingSize;
+    Texture       *texture = LookupTexture(SkinPaletteRing[slot]);
+    if (texture == nullptr) {
+        return kNullTexture;
+    }
+    // TEMP skin-palette probe
+    static int logged = 0;
+    if (logged < 8) {
+        ++logged;
+        kz::Logf(kz::LogLevel::Info, "gfx", "skinring {}: slot={} handle={:#x} bone{}x={:.2f} frame={}", logged, slot,
+                 SkinPaletteRing[slot], SkinPaletteCursor - 1, palette.bones[SkinPaletteCursor - 1][0][3], g.frame_serial);
+    }
+    // Inline upload: the draw path already runs on the device thread with the frame's commands
+    // open, and a dispatched update would land behind the draw that samples the texture. The copy
+    // records into the draw command buffer itself, ahead of the draw, so the ordering holds
+    // whatever phase of the frame the draw runs in.
+    texture->last_draw_use = g.frame_serial;
+    TransientSpan staging = AllocateStaging(static_cast<VkDeviceSize>(kSkinPaletteWidth) * 16);
+    std::memcpy(staging.data, &palette, sizeof(Prog0Palette));
+    EndRendering();
+    VkCommandBuffer cmd = DrawCommands();
+    Transition(cmd, texture->image, TransferDst());
+    VkBufferImageCopy region = {};
+    region.bufferOffset = staging.offset;
+    region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+    region.imageExtent = {kSkinPaletteWidth, 1, 1};
+    vkCmdCopyBufferToImage(cmd, staging.buffer, texture->image.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                           1, &region);
+    ToRest(cmd, texture->image);
+    return SkinPaletteRing[slot];
+}
+
+uint32_t SkinPaletteCursorForTest() { return SkinPaletteCursor; }
+
+// The ring texture the last placement filled, for tests that inspect the delivered bytes.
+TextureHandle SkinPaletteTextureForTest() {
+    return SkinPaletteRing[(SkinPaletteCursor + kSkinPaletteRingSize - 1) % kSkinPaletteRingSize];
+}
