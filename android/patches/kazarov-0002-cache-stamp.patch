diff --git a/src/cpp/gfx/shaders/mesh_prog0_bound.vert b/src/cpp/gfx/shaders/mesh_prog0_bound.vert
new file mode 100644
index 0000000..06c7394
--- /dev/null
+++ b/src/cpp/gfx/shaders/mesh_prog0_bound.vert
@@ -0,0 +1,269 @@
+#version 460
+
+// Dark Chronicle's Vu_prog0 for the pushed-descriptor path, where the skin palette rides a texture:
+// each placement takes the next ring texture of 96 RGBA32F texels (32 bones, 3 rows each) and the
+// draw's pushed palette slot names it. The vertex stage fetches its rows by texel, which Adreno's
+// compiler handles, instead of the storage buffer it misreads - there every skinned character drew
+// its bind pose. Everything else matches mesh_prog0.vert; see it for the O-n notes.
+
+layout(constant_id = 0) const bool kSkinned = false;
+
+layout(location = 0) in vec3 a_position;
+layout(location = 1) in vec3 a_normal;
+layout(location = 2) in vec2 a_uv;
+layout(location = 3) in vec4 a_color;
+layout(location = 4) in vec4 a_skin_weight;
+layout(location = 5) in uvec4 a_skin_bone;
+
+layout(set = 0, binding = 1) uniform texture2D u_skin_palette;
+layout(set = 0, binding = 3) uniform sampler u_skin_palette_sampler;
+
+layout(push_constant, std430) uniform Push {
+    vec4 xform;
+    vec4 uv_xform;
+    uint texture_slot;
+    uint palette_slot;
+    uint sampler_slot;
+    uint flags;
+    uint alpha;
+    uint fog_color;
+    uint face;
+    uint mesh_index;
+    uint prog0_index;
+    uint palette_index;
+}
+pc;
+
+// gfx::MeshConstants, identical to mesh.vert's records. Each chunk's records form one array;
+// the draw's record is at pc.mesh_index.
+struct MeshConstantsData {
+    mat4 mvp;
+    mat3 normal_matrix;
+    vec4 light_direction[4];
+    vec4 light_color[4];
+    vec4 ambient;
+    vec4 diffuse;
+    vec4 ambient_material;
+    vec4 specular;
+    vec4 fog;
+    vec4 clip_plane[2];
+    vec4 world_uv[2];
+    uint flags;
+    uint light_count;
+};
+
+layout(set = 1, binding = 0, std430) readonly buffer MeshConstantsArray {
+    MeshConstantsData meshes[];
+};
+
+#define mc meshes[pc.mesh_index]
+
+// gfx::Prog0Constants in the VU's units (128 is 1.0). The draw's record is at pc.prog0_index.
+struct Prog0Data {
+    mat4 model_world;
+    vec4 light_direction[3];
+    vec4 light_color[4];
+    vec4 ambient;
+    vec4 object_color;
+    vec4 eye;
+    mat4 clip_or_view;
+    vec4 diffuse;
+    vec4 specular;
+    vec4 point_light[4];
+    vec4 point_color[4];
+    vec4 fog;
+    uint flags;
+    uint pad0;
+    uint specular_power;
+    uint pad;
+};
+
+layout(set = 1, binding = 1, std430) readonly buffer Prog0Array {
+    Prog0Data prog0_blocks[];
+};
+
+#define p0 prog0_blocks[pc.prog0_index]
+
+// Row r of bone b of the draw's skin palette: texel b * 3 + r of the ring texture.
+vec4 palette_row(uint bone, uint row) {
+    return texelFetch(sampler2D(u_skin_palette, u_skin_palette_sampler),
+                      ivec2(int(bone * 3u + row), 0), 0);
+}
+
+const uint kScissor      = 0x002u;
+const uint kReal         = 0x008u;
+const uint kPointLights  = 0x010u;
+const uint kUnlit        = 0x020u;
+const uint kBlend        = 0x040u;
+const uint kColorAdd     = 0x080u;
+const uint kRefSphere    = 0x100u;
+
+const uint kFaceColor    = 0x100u;
+const uint kFaceNoNormal = 0x200u;
+
+// A vertex colour byte of 0x80 is the VU's 1.0.
+const float kModulate = 255.0 / 128.0;
+const float kVuMax    = 3.40282347e38;
+
+layout(location = 0) out vec4 v_color;
+layout(location = 1) out vec2 v_uv;
+layout(location = 2) out vec4 v_fog;
+layout(location = 3) flat out vec4 v_fog_mode;
+
+out float gl_ClipDistance[6];
+
+// VU rsqrt(0) is a finite maximum; anything scaled by it is zero.
+float vu_rsqrt(float s) {
+    return s > 0.0 ? inversesqrt(s) : 0.0;
+}
+
+vec3 vu_unit(vec3 v) {
+    return v * vu_rsqrt(dot(v, v));
+}
+
+void blend(inout vec3 position, inout vec3 normal) {
+    vec3 P = vec3(0.0);
+    vec3 N = vec3(0.0);
+    for (int i = 0; i < 4; i++) {
+        float w = a_skin_weight[i];
+        uint bone = min(a_skin_bone[i], 31u);
+        vec4 r0 = palette_row(bone, 0u);
+        vec4 r1 = palette_row(bone, 1u);
+        vec4 r2 = palette_row(bone, 2u);
+
+        vec4 pw = vec4(position * w, w);
+        P += vec3(dot(r0, pw), dot(r1, pw), dot(r2, pw));
+
+        vec3 nw = normal * w;
+        vec3 c0 = vec3(r0.x, r1.x, r2.x);
+        vec3 c1 = vec3(r0.y, r1.y, r2.y);
+        vec3 c2 = vec3(r0.z, r1.z, r2.z);
+        // O-8: retail reads column 1 for the z term of influence 3 (0x013E).
+        N += c0 * nw.x + c1 * nw.y + (i == 3 ? c1 : c2) * nw.z;
+    }
+    position = P;
+    normal = N;
+}
