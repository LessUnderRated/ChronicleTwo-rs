+    /// 256 MiB region; once the 632-byte BTreeMap leaves had filled theirs and every larger class, it mapped each
+    /// allocation on its own until the process ran out of mappings and aborted, about 830 MiB in. The allocator the
+    /// Rust side uses on Android has to hold well past that in a handful of mappings.
+    #[test]
+    #[cfg_attr(
+        not(target_os = "android"),
+        ignore = "Android's allocator: run on arm64 bionic (android/test/bionic.sh)"
+    )]
+    fn small_allocations_hold_past_a_scudo_size_class() {
+        const NODE: usize = 632;
+        const COUNT: usize = (1536 << 20) / NODE;
+        let mut nodes: Vec<Box<[u8; NODE]>> = Vec::with_capacity(COUNT);
+        for index in 0..COUNT {
+            nodes.push(Box::new([index as u8; NODE]));
+        }
+        assert!(
+            nodes
+                .iter()
+                .enumerate()
+                .step_by(4099)
+                .all(|(index, node)| node[NODE - 1] == index as u8)
+        );
+        let mappings =
+            std::fs::read_to_string("/proc/self/maps").map_or(0, |maps| maps.lines().count());
+        assert!(mappings < 10_000, "{mappings} mappings");
+    }
+}
