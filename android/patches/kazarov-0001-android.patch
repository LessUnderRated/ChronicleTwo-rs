 libc = "0.2"
 
+# Android's allocator, scudo, keeps each small size class in a 256 MiB region and, once that and every larger class
+# are full, gives each allocation its own mapping; the model pass's millions of small JSON nodes reached the
+# process's ~65k mappings and every allocation failed. mimalloc has no such classes (src/rust/lib.rs). Local-dynamic
+# TLS, because Android's linker refuses initial-exec TLS in a library loaded with dlopen, as the app's is.
+[target.'cfg(target_os = "android")'.dependencies]
+mimalloc = { version = "0.1.52", default-features = false, features = ["v2", "local_dynamic_tls"] }
+
 [features]
 # The desktop setup window; iOS builds without it.
 default = ["desktop-ui"]
