+std::vector<kz::arena::SavedBlock> kz::arena::SaveBlocks() {
+    const std::lock_guard<std::mutex> lock(blocks_mutex);
+    std::vector<SavedBlock>           saved;
+    saved.reserve(g_blocks.size());
+    for (const Block &block : g_blocks) {
+        const unsigned char *begin = block.memory.base - block.memory.lead;
+        saved.push_back({
+            .owner = block.owner,
+            .root = block.memory.base,
+            .lead = block.memory.lead,
+            .requested = block.requested_bytes,
+            .generation = block.generation,
+            .bytes = {begin, begin + block.memory.lead + block.requested_bytes},
+        });
+    }
+    return saved;
+}
+
+bool kz::arena::RestoreBlocks(std::span<const SavedBlock> blocks, std::string *error) {
+    const std::lock_guard<std::mutex> lock(blocks_mutex);
+    auto                              fits = [](const Block &block, const SavedBlock &saved) {
+        return block.memory.base == saved.root && block.memory.lead == saved.lead &&
+               block.memory.capacity >= saved.requested && saved.bytes.size() == saved.lead + saved.requested;
+    };
+    // Every saved block finds its mapping before anything is written.
+    std::vector<std::size_t> retired_back;
+    for (const SavedBlock &saved : blocks) {
+        const bool active = std::ranges::any_of(g_blocks, [&](const Block &block) { return fits(block, saved); });
+        if (active) {
+            continue;
+        }
+        const auto retired = std::ranges::find_if(g_retired, [&](const Block &block) { return fits(block, saved); });
+        if (retired == g_retired.end()) {
+            if (error != nullptr) {
+                *error = std::format("no mapping at {:p} for {} bytes", saved.root, saved.lead + saved.requested);
+            }
+            return false;
+        }
+        retired_back.push_back(static_cast<std::size_t>(retired - g_retired.begin()));
+    }
+    // A retired mapping becomes its owner's active one again; the mapping it replaces is retired, still mapped.
+    std::ranges::sort(retired_back, std::greater<>());
+    for (const std::size_t index : retired_back) {
+        Block back = g_retired[index];
+        g_retired.erase(g_retired.begin() + static_cast<std::ptrdiff_t>(index));
+        const auto current = std::ranges::find_if(g_blocks, [&](const Block &block) { return block.owner == back.owner; });
+        if (current != g_blocks.end()) {
+            ArenaMemoryZero(current->memory);
+            g_retired.push_back(*current);
+            *current = back;
+        } else {
+            g_blocks.push_back(back);
+        }
+    }
+    for (Block &block : g_blocks) {
+        const auto saved = std::ranges::find_if(blocks, [&](const SavedBlock &candidate) { return fits(block, candidate); });
+        if (saved == blocks.end()) {
+            ArenaMemoryZero(block.memory);
+            block.generation = NewGeneration();
+            continue;
+        }
+        // Past the saved extent the block holds nothing, as it did when it was saved.
+        ArenaMemoryZero(block.memory);
+        std::memcpy(block.memory.base - block.memory.lead, saved->bytes.data(), saved->bytes.size());
+        block.owner = saved->owner;
+        block.requested_bytes = saved->requested;
+        block.generation = saved->generation;
+    }
+    // Epoch moves so cached liveness answers are asked again.
+    NewGeneration();
+    return true;
+}
