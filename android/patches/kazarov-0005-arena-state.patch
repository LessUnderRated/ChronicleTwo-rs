+
+TEST(PlatformArenaState, RestoreBringsBackBytesAndIdentity) {
+    static char    key;
+    unsigned char *base = ArenaBlock(&key, 4096, 64);
+    std::memset(base - 64, 0x11, 64 + 4096);
+    const auto region = kz::arena::RegionFor(base);
+    ASSERT_TRUE(region.has_value());
+    const auto saved = kz::arena::SaveBlocks();
+
+    std::memset(base, 0x22, 4096);
+    ArenaClearAll();
+    ASSERT_FALSE(kz::arena::IsLive(*region));
+
+    std::string error;
+    ASSERT_TRUE(kz::arena::RestoreBlocks(saved, &error)) << error;
+    EXPECT_TRUE(std::all_of(base - 64, base + 4096, [](unsigned char byte) { return byte == 0x11; }));
+    EXPECT_TRUE(kz::arena::IsLive(*region));
+}
+
+TEST(PlatformArenaState, AnOwnerThatOutgrewItsBlockGetsTheSavedMappingBack) {
+    static char           key;
+    constexpr std::size_t kGrown = std::size_t{1} << 20;
+    unsigned char        *small = ArenaBlock(&key, 1000);
+    small[0] = 0x5A;
+    const auto saved = kz::arena::SaveBlocks();
+
+    unsigned char *grown = ArenaBlock(&key, kGrown);
+    ASSERT_NE(grown, small);
+    std::string error;
+    ASSERT_TRUE(kz::arena::RestoreBlocks(saved, &error)) << error;
+    EXPECT_EQ(small[0], 0x5A);
+    EXPECT_EQ(ArenaBlock(&key, 1000), small);
+    // The grown mapping stays mapped and reads zeroes, as a retired block does.
+    EXPECT_TRUE(ArenaContains(grown));
+    EXPECT_EQ(grown[kGrown - 1], 0);
+}
+
+TEST(PlatformArenaState, ABlockMadeAfterTheSaveIsZeroedWithANewIdentity) {
+    const auto     saved = kz::arena::SaveBlocks();
+    static char    key;
+    unsigned char *later = ArenaBlock(&key, 1000);
+    later[0] = 0x33;
+    const auto region = kz::arena::RegionFor(later);
+    ASSERT_TRUE(region.has_value());
+
+    std::string error;
+    ASSERT_TRUE(kz::arena::RestoreBlocks(saved, &error)) << error;
+    EXPECT_EQ(later[0], 0);
+    EXPECT_FALSE(kz::arena::IsLive(*region));
+}
+
+TEST(PlatformArenaState, ABlockWithNoMappingLeavesEverythingAsItWas) {
+    static char    key;
+    unsigned char *base = ArenaBlock(&key, 1000);
+    base[0] = 0x44;
+    auto saved = kz::arena::SaveBlocks();
+    static char foreign;
+    saved.push_back({.owner = &foreign, .root = &foreign, .lead = 0, .requested = 16, .generation = 1,
+                     .bytes = std::vector<unsigned char>(16)});
+    base[0] = 0x55;
+
+    std::string error;
+    EXPECT_FALSE(kz::arena::RestoreBlocks(saved, &error));
+    EXPECT_FALSE(error.empty());
+    EXPECT_EQ(base[0], 0x55);
+}
