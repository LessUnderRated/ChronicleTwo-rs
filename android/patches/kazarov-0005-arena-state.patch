+/**
+ *
+ * One active block as a save state holds it: where it is, its identity, and its writable bytes (lead included).
+ *
+ */
+struct SavedBlock {
+    const void               *owner = nullptr;   /**< Caller identity the block is kept for. */
+    const void               *root = nullptr;    /**< Canonical root address returned by ArenaBlock. */
+    std::size_t               lead = 0;          /**< Usable bytes before root. */
+    std::size_t               requested = 0;     /**< Largest payload the owner asked for. */
+    std::uint64_t             generation = 0;    /**< Mapping identity when saved. */
+    std::vector<unsigned char> bytes;            /**< lead + requested bytes from root - lead. */
+};
+
+/**
+ *
+ * Copies every active block, in the order they were made.
+ *
+ */
+std::vector<SavedBlock> SaveBlocks();
+
+/**
+ *
+ * Puts saved blocks back at their addresses, with their identities, so a pointer the game kept and a Region the host
+ * captured both mean again what they meant when the blocks were saved. A saved block's mapping must still exist in
+ * this process with room for it: active, or retired since (an owner that outgrew it), which becomes its owner's active
+ * block again. Active blocks the state does not hold are zeroed with new identities. Nothing changes and false comes
+ * back, with the reason in error, when a block has no mapping to go back into.
+ *
+ */
+bool RestoreBlocks(std::span<const SavedBlock> blocks, std::string *error);
+
 } // namespace kz::arena
