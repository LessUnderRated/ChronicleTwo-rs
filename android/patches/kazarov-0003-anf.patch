diff --git a/include/gfx/anf_fg.hpp b/include/gfx/anf_fg.hpp
new file mode 100644
index 0000000..84ea5ee
--- /dev/null
+++ b/include/gfx/anf_fg.hpp
@@ -0,0 +1,46 @@
+// ANF frame generation lifecycle for the Android renderer. Qualcomm's Adreno Neural
+// Fusion interpolates a display frame between two rendered canonical frames; the
+// renderer keeps its canonical colour double-buffered, so the current colour, the
+// shared depth and a camera-reprojected motion pass are the inputs, and the generated
+// frame lands in a dedicated image the canonical present shows first.
+#ifndef GFX_ANF_FG_HPP
+#define GFX_ANF_FG_HPP
+
+#include "gfx/context.hpp"
+
+namespace gfx::detail {
+
+// One-time setup after the device and queue exist; safe to call again. Android only:
+// without libanf.so this turns the whole module off.
+void FrameGenInit();
+void FrameGenShutdown();
+// Creates or resizes the motion-vector and generated-frame images at the canonical size;
+// device_idle says whether the caller has the device quiescent (semaphores may be rebuilt).
+void FrameGenEnsureTargets(uint32_t width, uint32_t height, bool device_idle);
+bool FrameGenActive();
+// Records the motion pass and prepares the input layouts inside the canonical frame's
+// command buffer; the caller submits it with the returned pair wired as extra wait/signal
+// semaphores (the previous generation's output, this generation's completion).
+void FrameGenRecordCanonical(VkCommandBuffer cmd, Image &color, Image &depth, VkSemaphore &wait,
+                             VkSemaphore &signal);
+// Immediately after the canonical submit: hands the images to ANF, which generates the
+// between-frame into its own submission. submit_fence is that submit's fence, waited if the
+// dispatch fails so the slot's semaphores can be rebuilt without double-signaling.
+void FrameGenDispatch(VkFence submit_fence);
+// True while a generated frame for the newest canonical waits to be shown.
+bool FrameGenHasOutput();
+// The generated frame is being presented this canonical commit: mark it consumed.
+void FrameGenNotePresented();
+// The semaphore ANF signals when the pending generated frame is ready; the frame itself.
+VkSemaphore FrameGenOutputDone();
+Image      &FrameGenOutputImage();
+// Presents the pending generated frame through a normal single swapchain cycle (acquire, blit,
+// present), waiting on ANF's completion. The port calls this for a tick's display slot in place
+// of the interpolated replay.
+bool PresentFrameGenerated();
+// displaylist.cpp reports the canonical camera's world-to-clip each canonical frame.
+void FrameGenSetClip(const float *world_to_clip);
+
+} // namespace gfx::detail
+
+#endif
