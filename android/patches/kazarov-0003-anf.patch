+void FrameGenDispatch(VkFence submit_fence) {}
+bool FrameGenHasOutput() { return false; }
+void FrameGenNotePresented() {}
+VkSemaphore FrameGenOutputDone() { return VK_NULL_HANDLE; }
+Image      &FrameGenOutputImage() { static Image never; return never; }
+void FrameGenSetClip(const float *) {}
+} // namespace gfx::detail
+#endif
