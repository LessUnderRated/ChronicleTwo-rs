diff --git a/src/cpp/gfx/shaders/anf_motion.frag b/src/cpp/gfx/shaders/anf_motion.frag
new file mode 100644
index 0000000..9e15194
--- /dev/null
+++ b/src/cpp/gfx/shaders/anf_motion.frag
@@ -0,0 +1,37 @@
+#version 450
+// ANF frame-generation motion vectors: camera-only reprojection of the canonical depth.
+// World position comes from the current inverse view-projection at the stored depth; the
+// previous view-projection projects it back. Moving objects inherit camera-only motion for
+// now; the interpolation machinery's per-object poses can refine this later.
+layout(location = 0) in vec2 uv;
+layout(location = 0) out vec2 motion;
+
+layout(set = 0, binding = 0) uniform Clips {
+    mat4 cur_inv_view_proj;
+    mat4 prev_view_proj;
+} clips;
+layout(set = 0, binding = 1) uniform sampler2D depth_tex;
+
+void main() {
+    float depth = texture(depth_tex, uv).r;
+    if (depth >= 1.0) {
+        // Sky and cleared pixels: nothing to reproject.
+        motion = vec2(0.0);
+        return;
+    }
+    vec4 clip = vec4(uv * 2.0 - 1.0, depth, 1.0);
+    vec4 world = clips.cur_inv_view_proj * clip;
+    if (world.w == 0.0) {
+        motion = vec2(0.0);
+        return;
+    }
+    world /= world.w;
+    vec4 prev = clips.prev_view_proj * vec4(world.xyz, 1.0);
+    if (prev.w <= 0.0) {
+        motion = vec2(0.0);
+        return;
+    }
+    vec2 prev_ndc = prev.xy / prev.w;
+    // Half the NDC displacement is the UV displacement ANF expects.
+    motion = 0.5 * (prev_ndc - clip.xy);
+}
diff --git a/src/cpp/gfx/shaders/anf_motion.vert b/src/cpp/gfx/shaders/anf_motion.vert
new file mode 100644
index 0000000..00b835e
--- /dev/null
+++ b/src/cpp/gfx/shaders/anf_motion.vert
@@ -0,0 +1,8 @@
+#version 450
+// Fullscreen triangle for the ANF frame-generation motion pass.
+layout(location = 0) out vec2 uv;
+void main() {
+    vec2 p = vec2(float((gl_VertexIndex << 1) & 2), float(gl_VertexIndex & 2));
+    uv = p;
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
