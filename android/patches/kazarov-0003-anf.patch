+//       Copyright (c) 2026, Qualcomm Technologies, Inc. and/or its subsidiaries. All rights reserved.
+//                              SPDX-License-Identifier: BSD-3-Clause
+//
+//============================================================================================================
+
+/**
+********************************************************************************************************************************
+* @file  anf_types_vk.h
+* @brief ANF API Vulkan specific types
+********************************************************************************************************************************
+*/
+
+#ifndef ANF_TYPES_VK_H
+#define ANF_TYPES_VK_H
+
+#include "anf_types.h"
+#include <vulkan/vulkan.h>
+
+/*******************************************************************************************************************************
+*   @brief
+*       Adapter info for Vulkan
+*******************************************************************************************************************************/
+struct AnfAdapterInfoVulkan
+{
+    AnfStructHeader     header;             ///< Standard struct header
+    VkInstance          instance;           ///< Vulkan instance
+    VkPhysicalDevice    physicalDevice;     ///< Vulkan physical device
+    VkDevice            device;             ///< Vulkan logical device
+};
+
+/*******************************************************************************************************************************
+*   @brief
+*       Queue info for Vulkan.  Extends AnfAdapterInfoVulkan
+*******************************************************************************************************************************/
+struct AnfQueueInfoVulkan
+{
+    AnfStructHeader     header;              ///< Standard struct header
+    uint32_t            numQueues;           ///< Number of queues provided
+    VkQueue*            pQueues;             ///< Array of size numQueues. Contains VkQueue handles this instance will submit to.
+    uint32_t*           pQueueFamilyIndices; ///< Array of size numQueues. Contains the queue family index of the corresponding 
+                                              ///< VkQueue in pQueues.
+};
+
+/*******************************************************************************************************************************
+*   @brief
+*       Requirements for a given technique that are specific to the Vulkan client API
+*******************************************************************************************************************************/
+struct AnfTechniqueVulkanApiRequirements
+{
+    AnfStructHeader     header;                 ///< Standard struct header
+
+    // Required Vulkan instance extensions
+    uint32_t            numInstanceExtensions;  ///< Number of required Vulkan instance extensions
+    const char* const*  ppInstanceExtensions;   ///< Array of char* values, each pointing to a null-terminated char array string
+                                                 ///< with the name of a required Vulkan instance extension
+
+    // Required Vulkan device extensions
+    uint32_t            numDeviceExtensions;    ///< Number of required Vulkan device extensions
+    const char* const*  ppDeviceExtensions;     ///< Array of char* values, each pointing to a null-terminated char array string
+                                                 ///< with the name of a required Vulkan device extension
+
+    VkQueueFlags        techniqueQueueFlags;    ///< The queue flags this technique's operations require.  
+                                                 ///< The VkCommandBuffer provided to DispatchTechnique must be submitted to a
+                                                 ///< queue whose QueueFamilyIndex supports all of these flags.
+                                                 ///< If using the flag ANF_TECHNIQUE_CREATE_FLAG_DISPATCH_IMMEDIATE, then an
+                                                 ///< AnfVulkanQueueInfo struct must have been in the pNext chain of the 
+                                                 ///< AnfSetClientAdapterInfo and for each bit set in techniqueQueueFlags, 
+                                                 ///< contain a queue supporting that flag.
+};
+
+/*******************************************************************************************************************************
+*   @brief
+*       Requirements for a given resource to be used in the queried technique that are specific to the Vulkan client API
+*******************************************************************************************************************************/
+struct AnfResourceVulkanApiRequirements
+{
+    AnfStructHeader     header;                             ///< Standard struct header
+
+    union /// usage flags depending on resource type
+    {
+        VkImageUsageFlags               imageUsageFlags;    ///< Image usage flags
+        VkBufferUsageFlags              bufferUsageFlags;   ///< Buffer usage flags
+    };
+
+    VkExternalMemoryHandleTypeFlags     externalMemoryType; ///< External memory type.  If != 0 the resource must be bound to
+                                                             ///< external memory
+};
+
+/*******************************************************************************************************************************
+*   @brief
+*       Technique create info specific to Vulkan
+*******************************************************************************************************************************/
+struct AnfTechniqueVulkanCreateInfo
+{
+    AnfStructHeader     header;                 ///< Standard struct header
+};
+
+#endif // ANF_TYPES_VK_H
diff --git a/src/cpp/gfx/anf_fg.cpp b/src/cpp/gfx/anf_fg.cpp
new file mode 100644
index 0000000..48118bb
--- /dev/null
+++ b/src/cpp/gfx/anf_fg.cpp
@@ -0,0 +1,784 @@
+﻿#include "gfx/anf_fg.hpp"
+
+#ifdef __ANDROID__
+#include <dlfcn.h>
+
+#include <algorithm>
+#include <cstring>
+
+#include "gfx/displaylist.hpp"
+#include "kazarov/log.hpp"
+#include "shaders/anf_motion.frag.spv.hpp"
+#include "shaders/anf_motion.vert.spv.hpp"
+
+#include "anf/anf.h"
+#include "anf/anf_fg.h"
+#include "anf/anf_sr.h"
+#include "anf/anf_types_vk.h"
+
+namespace gfx::detail {
+
+namespace {
+
+VkShaderModule MakeShaderModule(const uint32_t *code, size_t bytes) {
+    VkShaderModuleCreateInfo info = {};
+    info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+    info.codeSize = bytes;
+    info.pCode = code;
+    VkShaderModule module = VK_NULL_HANDLE;
+    Check(vkCreateShaderModule(g.device, &info, nullptr, &module), "anf shader module");
+    return module;
+}
+
+// Two world-to-clip matrices per slot: the canonical camera's this tick and last tick.
+struct ClipConstants {
+    Mat4 cur_world_to_clip;
+    Mat4 prev_world_to_clip;
+};
+static_assert(sizeof(ClipConstants) == 128);
+
+struct FgState {
+    bool         tried = false;     // the dlopen + support check ran
+    bool         available = false; // the technique is live and dispatching
+    void        *library = nullptr;
+    AnfFunctions fns = {};
+    AnfInstance  instance = nullptr;
+    AnfTechnique technique = nullptr;
+    uint32_t     width = 0;
+    uint32_t     height = 0;
+
+    // The ANF formats and usages the device's requirements query returned, mapped to Vulkan.
+    AnfFormat           anf_color = ANF_FORMAT_R8G8B8A8_UNORM;
+    AnfFormat           anf_depth = ANF_FORMAT_D32_FLOAT;
+    AnfFormat           anf_motion = ANF_FORMAT_R16G16_FLOAT;
+    VkImageUsageFlags   color_usage = 0;
+    VkImageUsageFlags   depth_usage = 0;
+    VkImageUsageFlags   motion_usage = 0;
+    VkImageUsageFlags   output_usage = 0;
+
+    Image motion;   // camera-only motion vectors, written by the fullscreen pass
+    Image output;   // the generated between-frame, blitted to the swapchain at present
+    VkFormat motion_format = VK_FORMAT_R16G16_SFLOAT;
+
+    VkDescriptorSetLayout set_layout = VK_NULL_HANDLE;
+    VkPipelineLayout      pipeline_layout = VK_NULL_HANDLE;
+    VkPipeline            pipeline = VK_NULL_HANDLE;
+    VkDescriptorPool      pool = VK_NULL_HANDLE;
+    VkSampler             sampler = VK_NULL_HANDLE;
+    VkImageView           depth_view = VK_NULL_HANDLE; // main_depth's depth-aspect view
+    Buffer                clips;                       // 4 slots x 128 bytes, host coherent
+    std::array<VkDescriptorSet, kFramesInFlight> sets = {};
+
+    std::array<VkSemaphore, kFramesInFlight> canon_done = {};  // the canonical submit's signal
+    std::array<VkSemaphore, kFramesInFlight> fg_done_present = {}; // ANF done: the generated frame's present waits
+    std::array<VkSemaphore, kFramesInFlight> fg_done_render = {};  // ANF done: the next canonical render waits
+    std::array<bool, kFramesInFlight>        dispatched = {}; // fg_done_render[slot] is meaningful
+
+    uint32_t slot = 0;
+    uint32_t failures = 0; // consecutive failed dispatches; four in a row retire the module
+    uint64_t dispatch_serial = 0;  // canonical commit serial the pending output was generated from
+    uint64_t presented_serial = 0; // serial whose generated frame has been shown
+    Mat4     cur_clip = {};
+    Mat4     prev_clip = {};
+    bool     have_clip = false;
+};
+
+FgState fg;
+
+const char *ResultName(AnfResult result) {
+    switch (result) {
+    case ANF_RESULT_SUCCESS: return "success";
+    case ANF_RESULT_NOT_SUPPORTED: return "not supported";
+    case ANF_RESULT_ERROR_INVALID_PARAMETER: return "invalid parameter";
+    default: return "error";
+    }
+}
+
+AnfFormat MapVulkanFormat(VkFormat format) {    switch (format) {
+    case VK_FORMAT_R8G8B8A8_UNORM: return ANF_FORMAT_R8G8B8A8_UNORM;
+    case VK_FORMAT_R16G16_SFLOAT: return ANF_FORMAT_R16G16_FLOAT;
+    case VK_FORMAT_D32_SFLOAT_S8_UINT: return ANF_FORMAT_D32_FLOAT;
+    case VK_FORMAT_D24_UNORM_S8_UINT: return ANF_FORMAT_D24S8_UNORM;
+    default: return ANF_FORMAT_UNKNOWN;
+    }
+}
+
+// Reads a label's resource requirements; picks the Vulkan format from the returned list and
+// collects the usage the resource must carry. The wanted format is per label: depth wants the
+// renderer's depth format, colors the RGBA8 target, motion vectors half-float RG.
+bool QueryResource(AnfResourceLabel label, AnfFormat &anf_format, VkImageUsageFlags &usage) {
+    const AnfFormat wanted = label == ANF_RESOURCE_LABEL_DEPTH  ? MapVulkanFormat(g.depth_format)
+                             : label == ANF_RESOURCE_LABEL_MOTION_VECTORS ? ANF_FORMAT_R16G16_FLOAT
+                                                                          : MapVulkanFormat(kColorFormat);
+    const AnfResourceRequirements *resource = nullptr;
+    if (fg.fns.QueryTechniqueResourceRequirements(fg.instance, ANF_TECHNIQUE_ID_FG_TEMPORAL, label, &resource) !=
+        ANF_RESULT_SUCCESS) {
+        return false;
+    }
+    const AnfStructHeader *api = resource != nullptr ? resource->pClientApiRequirements : nullptr;
+    if (resource == nullptr || api == nullptr || api->type != ANF_STYPE_RESOURCE_VULKAN_API_REQUIREMENTS) {
+        return false;
+    }
+    const auto *vulkan = reinterpret_cast<const AnfResourceVulkanApiRequirements *>(api);
+    usage = vulkan->imageUsageFlags;
+    if (vulkan->externalMemoryType != 0) {
+        kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation off, label {} needs external memory",
+                 static_cast<int>(label));
+        return false;
+    }
+    for (uint32_t index = 0; index < resource->numSupportedFormats; ++index) {
+        if (resource->pSupportedFormats[index] == wanted) {
+            anf_format = resource->pSupportedFormats[index];
+            return true;
+        }
+    }
+    kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation off, label {} rejects the renderer's format",
+             static_cast<int>(label));
+    return false;
+}
+
+void DestroyTargets(bool with_semaphores) {
+    DestroyImage(fg.motion);
+    DestroyImage(fg.output);
+    if (fg.depth_view != VK_NULL_HANDLE) {
+        vkDestroyImageView(g.device, fg.depth_view, nullptr);
+        fg.depth_view = VK_NULL_HANDLE;
+    }
+    if (fg.pool != VK_NULL_HANDLE) {
+        vkDestroyDescriptorPool(g.device, fg.pool, nullptr);
+        fg.pool = VK_NULL_HANDLE;
+        fg.sets.fill(VK_NULL_HANDLE);
+    }
+    // The semaphores go with the technique, but only when the device is idle: a dispatch that
+    // never got its wait would leave one signaled, and the next technique's first dispatch must
+    // not signal it again. In-flight submits hold their own, so resizing mid-frame keeps them.
+    if (with_semaphores) {
+        for (VkSemaphore &semaphore : fg.canon_done) {
+            if (semaphore != VK_NULL_HANDLE) {
+                vkDestroySemaphore(g.device, semaphore, nullptr);
+                semaphore = VK_NULL_HANDLE;
+            }
+        }
+        for (VkSemaphore &semaphore : fg.fg_done_present) {
+            if (semaphore != VK_NULL_HANDLE) {
+                vkDestroySemaphore(g.device, semaphore, nullptr);
+                semaphore = VK_NULL_HANDLE;
+            }
+        }
+        for (VkSemaphore &semaphore : fg.fg_done_render) {
+            if (semaphore != VK_NULL_HANDLE) {
+                vkDestroySemaphore(g.device, semaphore, nullptr);
+                semaphore = VK_NULL_HANDLE;
+            }
+        }
+        fg.dispatched.fill(false);
+    }
+    fg.width = 0;
+    fg.height = 0;
+}
+
+void EnsureSemaphores() {
+    VkSemaphoreCreateInfo info = {};
+    info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+    for (VkSemaphore &semaphore : fg.canon_done) {
+        Check(vkCreateSemaphore(g.device, &info, nullptr, &semaphore), "anf semaphore");
+    }
+    for (VkSemaphore &semaphore : fg.fg_done_present) {
+        Check(vkCreateSemaphore(g.device, &info, nullptr, &semaphore), "anf semaphore");
+    }
+    for (VkSemaphore &semaphore : fg.fg_done_render) {
+        Check(vkCreateSemaphore(g.device, &info, nullptr, &semaphore), "anf semaphore");
+    }
+}
+
+void DestroyTechnique() {
+    if (fg.technique != nullptr) {
+        fg.fns.DestroyTechnique(fg.instance, fg.technique);
+        fg.technique = nullptr;
+    }
+    fg.available = false;
+}
+
+// The technique is created (again) at the canonical size: FG's inputs and output all share it.
+bool CreateTechnique() {
+    DestroyTechnique();
+    AnfTechniqueVulkanCreateInfo vulkan = {};
+    vulkan.header.type = ANF_STYPE_TECHNIQUE_VULKAN_CREATE_INFO;
+    AnfFGCreateInfo group = {};
+    group.header.type = ANF_STYPE_FG_CREATE_INFO;
+    group.inputSize.width = fg.width;
+    group.inputSize.height = fg.height;
+    AnfTechniqueCreateInfo create = {};
+    create.header.type = ANF_STYPE_TECHNIQUE_CREATE_INFO;
+    create.techniqueId = ANF_TECHNIQUE_ID_FG_TEMPORAL;
+    create.flags = ANF_TECHNIQUE_CREATE_FLAG_DISPATCH_IMMEDIATE;
+    create.maxInFlight = kFramesInFlight;
+    create.pClientApiCreateInfo = &vulkan.header;
+    create.pTechniqueGroupCreateInfo = &group.header;
+    if (fg.fns.CreateTechnique(fg.instance, &create, &fg.technique) != ANF_RESULT_SUCCESS) {
+        kz::Logf(kz::LogLevel::Info, "gfx", "anf: the frame generation technique failed at {}x{}", fg.width,
+                 fg.height);
+        return false;
+    }
+    kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation technique ready at {}x{}", fg.width, fg.height);
+    return true;
+}
+
+} // namespace
+
+void FrameGenInit() {
+    if (fg.tried) {
+        return;
+    }
+    fg.tried = true;
+    // Armed regardless of the frame-generation setting: the support probe answers once, and the
+    // port flips between the generated and replayed between-frames at runtime.
+    fg.library = dlopen("libanf.so", RTLD_NOW | RTLD_LOCAL);
+    if (fg.library == nullptr) {
+        kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation off, libanf.so not packaged");
+        return;
+    }
+    auto *get_functions = reinterpret_cast<void (*)(AnfFunctions *)>(dlsym(fg.library, "GetAnfFunctions"));
+    if (get_functions == nullptr) {
+        kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation off, no GetAnfFunctions");
+        dlclose(fg.library);
+        fg.library = nullptr;
+        return;
+    }
+    get_functions(&fg.fns);
+    if (fg.fns.CreateInstance == nullptr || fg.fns.DestroyInstance == nullptr ||
+        fg.fns.SetInstanceClientAPIAdapterInfo == nullptr || fg.fns.QueryTechniqueRequirements == nullptr ||
+        fg.fns.QueryTechniqueResourceRequirements == nullptr || fg.fns.CreateTechnique == nullptr ||
+        fg.fns.DestroyTechnique == nullptr || fg.fns.DispatchTechnique == nullptr) {
+        kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation off, incomplete function table");
+        dlclose(fg.library);
+        fg.library = nullptr;
+        return;
+    }
+
+    AnfInstanceCreateInfo create = {};
+    create.header.type = ANF_STYPE_INSTANCE_CREATE_INFO;
+    create.logMessageCallback = [](AnfLogLevel, const char *message) {
+        kz::Logf(kz::LogLevel::Info, "gfx", "anf: {}", message);
+    };
+    create.logLevel = ANF_LOG_LEVEL_WARNING;
+    create.clientApi = ANF_CLIENT_API_VULKAN;
+    if (fg.fns.CreateInstance(&create, &fg.instance) != ANF_RESULT_SUCCESS) {
+        kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation off, instance creation failed");
+        dlclose(fg.library);
+        fg.library = nullptr;
+        return;
+    }
+
+    AnfQueueInfoVulkan queue_info = {};
+    queue_info.header.type = ANF_STYPE_QUEUE_INFO_VULKAN;
+    queue_info.numQueues = 1;
+    queue_info.pQueues = &g.queue;
+    queue_info.pQueueFamilyIndices = &g.queue_family;
+    AnfAdapterInfoVulkan adapter = {};
+    adapter.header.type = ANF_STYPE_ADAPTER_INFO_VULKAN;
+    adapter.header.pNext = &queue_info.header;
+    adapter.instance = g.instance;
+    adapter.physicalDevice = g.physical_device;
+    adapter.device = g.device;
+    if (fg.fns.SetInstanceClientAPIAdapterInfo(fg.instance, &adapter.header) != ANF_RESULT_SUCCESS) {
+        kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation off, the queue was rejected");
+        fg.fns.DestroyInstance(fg.instance);
+        fg.instance = nullptr;
+        dlclose(fg.library);
+        fg.library = nullptr;
+        return;
+    }
+
+    // Super resolution: the same adapter check, logged for the SR dynamic-scale mode. Done before
+    // the FG decision so the answer is in the log either way.
+    {
+        const AnfResult sr_supported =
+            fg.fns.IsTechniqueSupported(fg.instance, ANF_TECHNIQUE_ID_SR_TEMPORAL, &adapter.header);
+        kz::Logf(kz::LogLevel::Info, "gfx", "anf: SR temporal supported={} ({})",
+                 sr_supported == ANF_RESULT_SUCCESS ? "yes" : "no", ResultName(sr_supported));
+        const AnfTechniqueRequirements *sr_requirements = nullptr;
+        if (sr_supported == ANF_RESULT_SUCCESS &&
+            fg.fns.QueryTechniqueRequirements(fg.instance, ANF_TECHNIQUE_ID_SR_TEMPORAL, &sr_requirements) ==
+                ANF_RESULT_SUCCESS &&
+            sr_requirements != nullptr) {
+            const AnfStructHeader *group = sr_requirements->pTechniqueGroupRequirements;
+            if (group != nullptr && group->type == ANF_STYPE_SR_REQUIREMENTS) {
+                const auto *sr = reinterpret_cast<const AnfSRRequirements *>(group);
+                kz::Logf(kz::LogLevel::Info, "gfx", "anf: SR quality modes {:#x}", sr->supportedQualityModes);
+            }
+            for (uint32_t index = 0; index < sr_requirements->numRequiredResources; ++index) {
+                const AnfResourceLabel label = sr_requirements->pRequiredResources[index];
+                AnfFormat       format = ANF_FORMAT_UNKNOWN;
+                VkImageUsageFlags usage = 0;
+                const bool      ok = QueryResource(label, format, usage);
+                const char *name = label == ANF_RESOURCE_LABEL_DEPTH      ? "depth"
+                                   : label == ANF_RESOURCE_LABEL_MOTION_VECTORS ? "motion vectors"
+                                   : label == ANF_RESOURCE_LABEL_INPUT_COLOR ? "input color"
+                                                                             : "output color";
+                kz::Logf(kz::LogLevel::Info, "gfx", "anf:   SR {} format {} usage {:#x} ({})", name,
+                         static_cast<int>(format), usage, ok ? "accepted" : "rejected");
+            }
+        }
+    }
+
+    const AnfTechniqueRequirements *requirements = nullptr;
+    if (fg.fns.IsTechniqueSupported(fg.instance, ANF_TECHNIQUE_ID_FG_TEMPORAL, &adapter.header) !=
+            ANF_RESULT_SUCCESS ||
+        fg.fns.QueryTechniqueRequirements(fg.instance, ANF_TECHNIQUE_ID_FG_TEMPORAL, &requirements) !=
+            ANF_RESULT_SUCCESS ||
+        requirements == nullptr) {
+        kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation off, FG not supported on this device");
+        fg.fns.DestroyInstance(fg.instance);
+        fg.instance = nullptr;
+        dlclose(fg.library);
+        fg.library = nullptr;
+        return;
+    }
+    bool formats_ok = true;
+    for (uint32_t index = 0; index < requirements->numRequiredResources && formats_ok; ++index) {
+        switch (requirements->pRequiredResources[index]) {
+        case ANF_RESOURCE_LABEL_DEPTH: formats_ok = QueryResource(ANF_RESOURCE_LABEL_DEPTH, fg.anf_depth, fg.depth_usage); break;
+        case ANF_RESOURCE_LABEL_MOTION_VECTORS:
+            formats_ok = QueryResource(ANF_RESOURCE_LABEL_MOTION_VECTORS, fg.anf_motion, fg.motion_usage);
+            break;
+        case ANF_RESOURCE_LABEL_INPUT_COLOR: formats_ok = QueryResource(ANF_RESOURCE_LABEL_INPUT_COLOR, fg.anf_color, fg.color_usage); break;
+        case ANF_RESOURCE_LABEL_OUTPUT_COLOR:
+            formats_ok = QueryResource(ANF_RESOURCE_LABEL_OUTPUT_COLOR, fg.anf_color, fg.output_usage);
+            break;
+        default: formats_ok = false; break;
+        }
+    }
+    if (!formats_ok) {
+        fg.fns.DestroyInstance(fg.instance);
+        fg.instance = nullptr;
+        dlclose(fg.library);
+        fg.library = nullptr;
+        return;
+    }
+    fg.motion_format = VK_FORMAT_R16G16_SFLOAT;
+
+    // The motion pass: one set per frame in flight, each pointing at its own clip constants and
+    // the shared depth view.
+    VkDescriptorSetLayoutBinding bindings[2] = {};
+    bindings[0] = {0, VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 1, VK_SHADER_STAGE_FRAGMENT_BIT, nullptr};
+    bindings[1] = {1, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_FRAGMENT_BIT, nullptr};
+    VkDescriptorSetLayoutCreateInfo layout_info = {};
+    layout_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
+    layout_info.bindingCount = 2;
+    layout_info.pBindings = bindings;
+    Check(vkCreateDescriptorSetLayout(g.device, &layout_info, nullptr, &fg.set_layout), "anf motion set layout");
+    VkPipelineLayoutCreateInfo pipeline_info = {};
+    pipeline_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    pipeline_info.setLayoutCount = 1;
+    pipeline_info.pSetLayouts = &fg.set_layout;
+    Check(vkCreatePipelineLayout(g.device, &pipeline_info, nullptr, &fg.pipeline_layout), "anf motion layout");
+
+    VkSamplerCreateInfo sampler_info = {};
+    sampler_info.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO;
+    sampler_info.magFilter = VK_FILTER_LINEAR;
+    sampler_info.minFilter = VK_FILTER_LINEAR;
+    sampler_info.addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    sampler_info.addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    Check(vkCreateSampler(g.device, &sampler_info, nullptr, &fg.sampler), "anf motion sampler");
+
+    fg.clips = CreateBuffer(sizeof(ClipConstants) * kFramesInFlight, VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT, true);
+
+    // The motion pipeline: a fullscreen triangle with no vertex input, dynamic viewport/scissor,
+    // no depth, no blend.
+    VkShaderModule vert = MakeShaderModule(anf_motion_vert, sizeof(anf_motion_vert));
+    VkShaderModule frag = MakeShaderModule(anf_motion_frag, sizeof(anf_motion_frag));
+    VkPipelineShaderStageCreateInfo stages[2] = {};
+    stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+    stages[0].module = vert;
+    stages[0].pName = "main";
+    stages[1] = stages[0];
+    stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+    stages[1].module = frag;
+    VkPipelineInputAssemblyStateCreateInfo assembly = {};
+    assembly.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+    assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkPipelineViewportStateCreateInfo viewport = {};
+    viewport.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+    viewport.viewportCount = 1;
+    viewport.scissorCount = 1;
+    VkPipelineRasterizationStateCreateInfo raster = {};
+    raster.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+    raster.polygonMode = VK_POLYGON_MODE_FILL;
+    raster.cullMode = VK_CULL_MODE_NONE;
+    raster.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    raster.lineWidth = 1.0f;
+    VkPipelineMultisampleStateCreateInfo multisample = {};
+    multisample.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+    multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineDepthStencilStateCreateInfo depth_state = {};
+    depth_state.sType = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO;
+    VkPipelineColorBlendStateCreateInfo blend = {};
+    blend.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+    VkPipelineColorBlendAttachmentState attachment = {};
+    attachment.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT;
+    blend.attachmentCount = 1;
+    blend.pAttachments = &attachment;
+    VkDynamicState dynamics[] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+    VkPipelineDynamicStateCreateInfo dynamic = {};
+    dynamic.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+    dynamic.dynamicStateCount = 2;
+    dynamic.pDynamicStates = dynamics;
+    VkPipelineRenderingCreateInfo rendering = {};
+    rendering.sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO;
+    rendering.colorAttachmentCount = 1;
+    rendering.pColorAttachmentFormats = &fg.motion_format;
+    VkGraphicsPipelineCreateInfo pipeline = {};
+    pipeline.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+    pipeline.pNext = &rendering;
+    pipeline.stageCount = 2;
+    pipeline.pStages = stages;
+    pipeline.pInputAssemblyState = &assembly;
+    pipeline.pViewportState = &viewport;
+    pipeline.pRasterizationState = &raster;
+    pipeline.pMultisampleState = &multisample;
+    pipeline.pDepthStencilState = &depth_state;
+    pipeline.pColorBlendState = &blend;
+    pipeline.pDynamicState = &dynamic;
+    pipeline.layout = fg.pipeline_layout;
+    Check(vkCreateGraphicsPipelines(g.device, g.pipeline_cache, 1, &pipeline, nullptr, &fg.pipeline),
+          "anf motion pipeline");
+    vkDestroyShaderModule(g.device, vert, nullptr);
+    vkDestroyShaderModule(g.device, frag, nullptr);
+
+    kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation armed");
+}
+
+void FrameGenShutdown() {
+    if (fg.library == nullptr) {
+        return;
+    }
+    DestroyTargets(true);
+    DestroyTechnique();
+    if (fg.pipeline != VK_NULL_HANDLE) {
+        vkDestroyPipeline(g.device, fg.pipeline, nullptr);
+        fg.pipeline = VK_NULL_HANDLE;
+    }
+    if (fg.pipeline_layout != VK_NULL_HANDLE) {
+        vkDestroyPipelineLayout(g.device, fg.pipeline_layout, nullptr);
+        fg.pipeline_layout = VK_NULL_HANDLE;
+    }
+    if (fg.set_layout != VK_NULL_HANDLE) {
+        vkDestroyDescriptorSetLayout(g.device, fg.set_layout, nullptr);
+        fg.set_layout = VK_NULL_HANDLE;
+    }
+    if (fg.sampler != VK_NULL_HANDLE) {
+        vkDestroySampler(g.device, fg.sampler, nullptr);
+        fg.sampler = VK_NULL_HANDLE;
+    }
+    if (fg.clips.buffer != VK_NULL_HANDLE) {
+        DestroyBuffer(fg.clips);
+        fg.clips = {};
+    }
+    for (VkSemaphore &semaphore : fg.canon_done) {
+        if (semaphore != VK_NULL_HANDLE) {
+            vkDestroySemaphore(g.device, semaphore, nullptr);
+            semaphore = VK_NULL_HANDLE;
+        }
+    }
+    for (VkSemaphore &semaphore : fg.fg_done_present) {
+        if (semaphore != VK_NULL_HANDLE) {
+            vkDestroySemaphore(g.device, semaphore, nullptr);
+            semaphore = VK_NULL_HANDLE;
+        }
+    }
+    for (VkSemaphore &semaphore : fg.fg_done_render) {
+        if (semaphore != VK_NULL_HANDLE) {
+            vkDestroySemaphore(g.device, semaphore, nullptr);
+            semaphore = VK_NULL_HANDLE;
+        }
+    }
+    if (fg.instance != nullptr) {
+        fg.fns.DestroyInstance(fg.instance);
+        fg.instance = nullptr;
+    }
+    dlclose(fg.library);
+    fg.library = nullptr;
+    fg.available = false;
+}
+
+void FrameGenEnsureTargets(uint32_t width, uint32_t height, bool device_idle) {
+    if (!fg.instance || (fg.width == width && fg.height == height && fg.pipeline != VK_NULL_HANDLE)) {
+        return;
+    }
+    if (!device_idle) {
+        // Mid-frame the in-flight submits hold the semaphores and ANF may hold the images: only
+        // the images and views can be swapped, and the dispatch skips this mismatched tick.
+        return;
+    }
+    DestroyTargets(true);
+    EnsureSemaphores();
+    fg.width = width;
+    fg.height = height;
+    fg.motion_format = VK_FORMAT_R16G16_SFLOAT;
+    fg.motion = CreateImage(width, height, 1, fg.motion_format,
+                            fg.motion_usage | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT);
+    fg.output = CreateImage(width, height, 1, kColorFormat,
+                            fg.output_usage | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                                VK_IMAGE_USAGE_TRANSFER_SRC_BIT);
+    // The depth view and the sets that sample it exist only once the main targets do; on a resize
+    // the view is rebuilt against the new depth image.
+    if (fg.depth_view == VK_NULL_HANDLE && fg.pool == VK_NULL_HANDLE) {
+        VkImageViewCreateInfo view_info = {};
+        view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+        view_info.image = g.main_depth.image;
+        view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        view_info.format = g.depth_format;
+        view_info.subresourceRange = {VK_IMAGE_ASPECT_DEPTH_BIT, 0, 1, 0, 1};
+        Check(vkCreateImageView(g.device, &view_info, nullptr, &fg.depth_view), "anf depth view");
+        VkDescriptorPoolSize sizes[2] = {{VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, kFramesInFlight},
+                                         {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, kFramesInFlight}};
+        VkDescriptorPoolCreateInfo pool_info = {};
+        pool_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+        pool_info.maxSets = kFramesInFlight;
+        pool_info.poolSizeCount = 2;
+        pool_info.pPoolSizes = sizes;
+        Check(vkCreateDescriptorPool(g.device, &pool_info, nullptr, &fg.pool), "anf motion pool");
+        for (uint32_t slot = 0; slot < kFramesInFlight; slot++) {
+            VkDescriptorSetAllocateInfo allocate = {};
+            allocate.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+            allocate.descriptorPool = fg.pool;
+            allocate.descriptorSetCount = 1;
+            allocate.pSetLayouts = &fg.set_layout;
+            Check(vkAllocateDescriptorSets(g.device, &allocate, &fg.sets[slot]), "anf motion set");
+            VkDescriptorBufferInfo buffer_info = {fg.clips.buffer, slot * sizeof(ClipConstants),
+                                                  sizeof(ClipConstants)};
+            VkDescriptorImageInfo image_info = {fg.sampler, fg.depth_view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+            VkWriteDescriptorSet write[2] = {};
+            write[0] = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, fg.sets[slot], 0, 0, 1,
+                        VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, nullptr, &buffer_info, nullptr};
+            write[1] = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, fg.sets[slot], 1, 0, 1,
+                        VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &image_info, nullptr, nullptr};
+            vkUpdateDescriptorSets(g.device, 2, write, 0, nullptr);
+        }
+    } else if (fg.depth_view != VK_NULL_HANDLE) {
+        // A resize rebuilt the depth image: point every set's sampler at the new view.
+        vkDestroyImageView(g.device, fg.depth_view, nullptr);
+        VkImageViewCreateInfo view_info = {};
+        view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+        view_info.image = g.main_depth.image;
+        view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        view_info.format = g.depth_format;
+        view_info.subresourceRange = {VK_IMAGE_ASPECT_DEPTH_BIT, 0, 1, 0, 1};
+        Check(vkCreateImageView(g.device, &view_info, nullptr, &fg.depth_view), "anf depth view");
+        VkDescriptorImageInfo image_info = {fg.sampler, fg.depth_view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+        VkWriteDescriptorSet write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, nullptr, VK_NULL_HANDLE, 1, 0, 1,
+                                      VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, &image_info, nullptr, nullptr};
+        for (VkDescriptorSet set : fg.sets) {
+            write.dstSet = set;
+            vkUpdateDescriptorSets(g.device, 1, &write, 0, nullptr);
+        }
+    }
+    if (!fg.available) {
+        fg.available = CreateTechnique();
+        if (!fg.available) {
+            // Retire the module for the process: every later attempt would fail the same way.
+            DestroyTargets(true);
+            fg.instance = nullptr;
+            fg.available = false;
+        }
+    }
+}
+
+bool FrameGenActive() {
+    return fg.available;
+}
+
+void FrameGenRecordCanonical(VkCommandBuffer cmd, Image &color, Image &depth, VkSemaphore &wait,
+                             VkSemaphore &signal) {
+    // Pick up a resolution change here rather than waiting for the next target sync: the
+    // technique's dimensions must match the images this dispatch hands over.
+    FrameGenEnsureTargets(g.main_color[g.main_current].width, g.main_color[g.main_current].height, false);
+    if (!fg.available) {
+        return;
+    }
+    fg.slot = (fg.slot + 1) % kFramesInFlight;
+    const uint32_t slot = fg.slot;
+    // The camera matrices this canonical was drawn with, and the previous canonical's.
+    auto &constants = reinterpret_cast<ClipConstants *>(fg.clips.memory.mapped)[slot];
+    constants.cur_world_to_clip = fg.cur_clip;
+    constants.prev_world_to_clip = fg.have_clip ? fg.prev_clip : fg.cur_clip;
+    fg.prev_clip = fg.cur_clip;
+    fg.have_clip = true;
+
+    // The motion pass: read the canonical depth, write camera-only motion vectors.
+    ImageState render_state = {};
+    render_state.layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    render_state.stage = VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT;
+    render_state.access = VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT;
+    Transition(cmd, fg.motion, render_state);
+    VkRenderingAttachmentInfo attachment = {};
+    attachment.sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
+    attachment.imageView = fg.motion.view;
+    attachment.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    attachment.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    VkRenderingInfo rendering = {};
+    rendering.sType = VK_STRUCTURE_TYPE_RENDERING_INFO;
+    rendering.renderArea = {{0, 0}, {fg.width, fg.height}};
+    rendering.layerCount = 1;
+    rendering.colorAttachmentCount = 1;
+    rendering.pColorAttachments = &attachment;
+    vkCmdBeginRendering(cmd, &rendering);
+    vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, fg.pipeline);
+    VkViewport viewport = {0.0f, 0.0f, static_cast<float>(fg.width), static_cast<float>(fg.height), 0.0f, 1.0f};
+    VkRect2D scissor = {{0, 0}, {fg.width, fg.height}};
+    vkCmdSetViewport(cmd, 0, 1, &viewport);
+    vkCmdSetScissor(cmd, 0, 1, &scissor);
+    vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, fg.pipeline_layout, 0, 1, &fg.sets[slot], 0, nullptr);
+    vkCmdDraw(cmd, 3, 1, 0, 0);
+    vkCmdEndRendering(cmd);
+    ImageState read_state = {};
+    read_state.layout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    read_state.stage = VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT;
+    read_state.access = VK_ACCESS_2_SHADER_READ_BIT;
+    Transition(cmd, fg.motion, read_state);
+    // The depth rests as an attachment; ANF samples it, so hand it over shader-readable. The next
+    // canonical render's own transition starts from the state recorded here.
+    Transition(cmd, depth, read_state);
+    // ANF writes the generated frame in the general layout.
+    ImageState general_state = {};
+    general_state.layout = VK_IMAGE_LAYOUT_GENERAL;
+    general_state.stage = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    general_state.access = VK_ACCESS_2_MEMORY_WRITE_BIT | VK_ACCESS_2_MEMORY_READ_BIT;
+    Transition(cmd, fg.output, general_state);
+
+    const uint32_t previous_slot = (slot + kFramesInFlight - 1) % kFramesInFlight;
+    wait = fg.dispatched[previous_slot] ? fg.fg_done_render[previous_slot] : VK_NULL_HANDLE;
+    signal = fg.canon_done[slot];
+}
+
+void FrameGenDispatch(VkFence submit_fence) {
+    if (!fg.available) {
+        return;
+    }
+    const Image &canonical = g.main_color[g.main_current];
+    if (canonical.width != fg.width || canonical.height != fg.height) {
+        // The resolution changed under the technique: this dispatch would hand ANF mismatched
+        // images. Skip it; the next canonical commit rebuilds the technique first.
+        return;
+    }
+    const uint32_t slot = fg.slot;
+    AnfResourceParamDesc resources[4] = {};
+    const AnfResourceLabel labels[4] = {ANF_RESOURCE_LABEL_DEPTH, ANF_RESOURCE_LABEL_MOTION_VECTORS,
+                                        ANF_RESOURCE_LABEL_INPUT_COLOR, ANF_RESOURCE_LABEL_OUTPUT_COLOR};
+    const VkImage images[4] = {g.main_depth.image, fg.motion.image, g.main_color[g.main_current].image,
+                               fg.output.image};
+    const AnfFormat formats[4] = {fg.anf_depth, fg.anf_motion, fg.anf_color, fg.anf_color};
+    const uint32_t layouts[4] = {VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                                 VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL};
+    for (uint32_t index = 0; index < 4; index++) {
+        resources[index].header.type = ANF_STYPE_RESOURCE_PARAM_DESC;
+        resources[index].resourceLabel = labels[index];
+        resources[index].resourceDesc.header.type = ANF_STYPE_RESOURCE_DESC;
+        resources[index].resourceDesc.type = ANF_RESOURCE_TYPE_TEXTURE2D;
+        resources[index].resourceDesc.format = formats[index];
+        resources[index].resourceDesc.layout = layouts[index];
+        resources[index].resourceDesc.textureDims.width = fg.width;
+        resources[index].resourceDesc.textureDims.height = fg.height;
+        resources[index].resourceDesc.textureDims.numArrayLayers = 1;
+        resources[index].resourceDesc.textureDims.mipCount = 1;
+        resources[index].resourceDesc.resource = reinterpret_cast<AnfClientResource>(const_cast<VkImage>(images[index]));
+    }
+    // A camera cut leaves the previous frame unrelated; a big matrix jump resets the history.
+    bool reset = !fg.have_clip;
+    if (!reset) {
+        for (uint32_t i = 0; i < 16; i++) {
+            if (std::abs(fg.cur_clip[i] - fg.prev_clip[i]) > 2.0f) {
+                reset = true;
+                break;
+            }
+        }
+    }
+    AnfClientSyncObject wait_objects[] = {reinterpret_cast<AnfClientSyncObject>(fg.canon_done[slot])};
+    AnfClientSyncObject signal_objects[] = {reinterpret_cast<AnfClientSyncObject>(fg.fg_done_present[slot]),
+                                            reinterpret_cast<AnfClientSyncObject>(fg.fg_done_render[slot])};
+    AnfTechniqueDispatchImmediateInfo immediate = {};
+    immediate.header.type = ANF_STYPE_TECHNIQUE_DISPATCH_IMMEDIATE_INFO;
+    immediate.pWaitSyncObjects = wait_objects;
+    immediate.numWaitSyncObjects = 1;
+    immediate.pSignalSyncObjects = signal_objects;
+    immediate.numSignalSyncObjects = 2;
+    AnfFGDispatch group = {};
+    group.header.type = ANF_STYPE_FG_DISPATCH;
+    AnfTechniqueDispatchInfo dispatch = {};
+    dispatch.header.type = ANF_STYPE_TECHNIQUE_DISPATCH_INFO;
+    dispatch.header.pNext = &immediate.header;
+    dispatch.pResources = resources;
+    dispatch.numResources = 4;
+    dispatch.reset = reset ? ANF_TRUE : ANF_FALSE;
+    dispatch.pTechniqueGroupDispatchInfo = &group.header;
+    if (fg.fns.DispatchTechnique(fg.technique, &dispatch) != ANF_RESULT_SUCCESS) {
+        // A transient rejection (a resolution that changed under us) must not retire the module;
+        // only persistent failures do.
+        if (++fg.failures >= 4) {
+            kz::Logf(kz::LogLevel::Info, "gfx", "anf: frame generation disabled after {} failed dispatches",
+                     fg.failures);
+            fg.available = false;
+            return;
+        }
+        // The canonical submit's canon_done[slot] went unconsumed: drain the submit's fence, then
+        // rebuild the slot's semaphores so the next dispatch signals fresh ones.
+        vkWaitForFences(g.device, 1, &submit_fence, VK_TRUE, UINT64_MAX);
+        VkSemaphoreCreateInfo info = {};
+        info.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+        vkDestroySemaphore(g.device, fg.canon_done[slot], nullptr);
+        vkDestroySemaphore(g.device, fg.fg_done_present[slot], nullptr);
+        vkDestroySemaphore(g.device, fg.fg_done_render[slot], nullptr);
+        Check(vkCreateSemaphore(g.device, &info, nullptr, &fg.canon_done[slot]), "anf semaphore");
+        Check(vkCreateSemaphore(g.device, &info, nullptr, &fg.fg_done_present[slot]), "anf semaphore");
+        Check(vkCreateSemaphore(g.device, &info, nullptr, &fg.fg_done_render[slot]), "anf semaphore");
+        fg.dispatched[slot] = false;
+        return;
+    }
+    fg.failures = 0;
+    fg.dispatched[slot] = true;
+    fg.dispatch_serial = g.canonical_commit_serial;
+}
+
+bool FrameGenHasOutput() {
+    return fg.available && fg.dispatch_serial != fg.presented_serial &&
+           fg.dispatch_serial == g.canonical_commit_serial;
+}
+
+void FrameGenNotePresented() {
+    fg.presented_serial = fg.dispatch_serial;
+}
+
+VkSemaphore FrameGenOutputDone() {
+    return fg.available ? fg.fg_done_present[fg.slot] : VK_NULL_HANDLE;
+}
+
+Image &FrameGenOutputImage() {
+    return fg.output;
+}
+
+void FrameGenSetClip(const float *world_to_clip) {
+    std::memcpy(fg.cur_clip.data(), world_to_clip, sizeof(Mat4));
+}
+
